{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":[" "],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"2028 \ub300\uc785 \uc548\ub0b4","text":"<p>2028\ud559\ub144\ub3c4 \ub300\ud559\uc785\uc2dc\ub97c \uc900\ube44\ud558\ub294 \ud559\uc0dd\u00b7\ud559\ubd80\ubaa8\u00b7\uad50\uc0ac\ub97c \uc704\ud55c \ube44\uacf5\uc2dd \uc548\ub0b4 \uc0ac\uc774\ud2b8\uc785\ub2c8\ub2e4. \ub300\uad50\ud611(\ud55c\uad6d\ub300\ud559\uad50\uc721\ud611\uc758\ud68c)\uacfc \uad50\uc721\ubd80\uac00 \ubc1c\ud45c\ud55c \uc790\ub8cc\ub97c \uc694\uc57d\ud574 \uc815\ub9ac\ud588\uc2b5\ub2c8\ub2e4.</p> <p>\uaf2d \ud655\uc778\ud558\uc138\uc694 \uc774 \uc0ac\uc774\ud2b8\ub294 \uacf5\uc2dd \uc790\ub8cc\ub97c \uc694\uc57d\ud55c \ucc38\uace0\uc6a9\uc785\ub2c8\ub2e4. \uc9c0\uc6d0 \uc804\uc5d0\ub294 \ubc18\ub4dc\uc2dc \uacf5\uc2dd \uc790\ub8cc \ub9c1\ud06c\uc640 \uc9c0\uc6d0 \ub300\ud559\uc758 \ubaa8\uc9d1\uc694\uac15\uc5d0\uc11c \ucd5c\uc885 \ud655\uc778\ud558\uc138\uc694.</p>"},{"location":"#_1","title":"\ud55c\ub208\uc5d0 \ubcf4\uae30","text":"\uad6c\ubd84 \ub0b4\uc6a9 \ub300\uc0c1 2025\ub144 \uace0\ub4f1\ud559\uad50 1\ud559\ub144\uc73c\ub85c \uc785\ud559\ud55c \ud559\uc0dd\ubd80\ud130 (2026\ub144 \uae30\uc900 \uace02, 2027\ub144 \uace03) \uc218\ub2a5 2027\ub144 11\uc6d4 18\uc77c(\ubaa9), \uad6d\uc5b4\u00b7\uc218\ud559\u00b7\ud0d0\uad6c \uc120\ud0dd\uacfc\ubaa9 \uc5c6\ub294 \ud1b5\ud569\ud615 \uc218\ub2a5 \ub0b4\uc2e0 \uc11d\ucc28\ub4f1\uae09 5\ub4f1\uae09\uc81c (\uc131\ucde8\ud3c9\uac00 A~E \ubcd1\uae30) \uc218\uc2dc \uc6d0\uc11c\uc811\uc218 2027\ub144 9\uc6d4 20\uc77c~23\uc77c \uc911 \ub300\ud559\ubcc4 3\uc77c \uc774\uc0c1 \uc815\uc2dc \uc6d0\uc11c\uc811\uc218 2028\ub144 1\uc6d4 3\uc77c~6\uc77c \uc911 \ub300\ud559\ubcc4 3\uc77c \uc774\uc0c1"},{"location":"#_2","title":"\ubc14\ub85c\uac00\uae30","text":"<ul> <li>2028 \ub300\uc785 \uac1c\uc694: \ubb34\uc5c7\uc774 \ubc14\ub00c\uc5c8\ub098</li> <li>\uc804\ud615 \uc77c\uc815: \uc218\ub2a5\u00b7\uc218\uc2dc\u00b7\uc815\uc2dc \ub0a0\uc9dc</li> <li>\uc218\uc2dc / \uc815\uc2dc: \ubaa8\uc9d1 \uaddc\ubaa8\uc640 \uc720\uc758\uc0ac\ud56d</li> <li>\ud559\ub144\ubcc4 \uc900\ube44: \uc2dc\uae30\ubcc4 \uc810\uac80 \ud56d\ubaa9</li> <li>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38</li> <li>\uacf5\uc2dd \uc790\ub8cc \ub9c1\ud06c</li> </ul> <p>\ucd5c\uc885 \ud655\uc778\uc77c: 2026-11-13 (\uc774\ud6c4 \ubc1c\ud45c\u00b7\uac1c\uc815 \uc0ac\ud56d\uc740 \uacf5\uc2dd \uc790\ub8cc\ub85c \ud655\uc778\ud574 \uc8fc\uc138\uc694)</p>"},{"location":"faq/","title":"\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38","text":""},{"location":"faq/#2028","title":"2028\ud559\ub144\ub3c4 \uc218\ub2a5\uc5d0\uc11c \uac00\uc7a5 \ud06c\uac8c \ub2ec\ub77c\uc9c0\ub294 \uc810\uc740?","text":"<p>\uad6d\uc5b4\u00b7\uc218\ud559\u00b7\ud0d0\uad6c \uc601\uc5ed\uc758 \uc120\ud0dd\uacfc\ubaa9\uc774 \uc5c6\uc5b4\uc9c0\uace0, \ubaa8\ub4e0 \uc218\ud5d8\uc0dd\uc774 \uac19\uc740 \uc2dc\ud5d8\uc744 \uce58\ub974\ub294 \ud1b5\ud569\ud615 \uccb4\uc81c\uac00 \ub429\ub2c8\ub2e4. \uc0ac\ud68c\u00b7\uacfc\ud559\ud0d0\uad6c\ub294 \ud1b5\ud569\uc0ac\ud68c\uc640 \ud1b5\ud569\uacfc\ud559 \ub450 \uacfc\ubaa9\uc744 \ubaa8\ub450 \uc751\uc2dc\ud569\ub2c8\ub2e4.</p>"},{"location":"faq/#_2","title":"\uc218\ub2a5\uc740 \uc5b8\uc81c\uc778\uac00\uc694?","text":"<p>2027\ub144 11\uc6d4 18\uc77c(\ubaa9)\uc774\uba70, \uc131\uc801\uc740 12\uc6d4 10\uc77c(\uae08)\uc5d0 \ud1b5\uc9c0\ub429\ub2c8\ub2e4.</p>"},{"location":"faq/#_3","title":"\uc120\ud0dd\uacfc\ubaa9\uc774 \uc5c6\uc5b4\uc84c\ub2e4\uba74 \ubb38\uacfc\u00b7\uc774\uacfc \uad6c\ubd84\uc740 \uc0ac\ub77c\uc9c0\ub098\uc694?","text":"<p>\uc218\ub2a5\uc758 \uc751\uc2dc \ubc29\uc2dd\uc774 \ud1b5\ud569\ud615\uc73c\ub85c \ubc14\ub00c\ub294 \uac83\uc774\uba70, \ub300\ud559\uc758 \ubaa8\uc9d1\ub2e8\uc704\uc640 \uc9c0\uc6d0 \uc790\uaca9\uc740 \ub300\ud559\ubcc4\ub85c \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\ud559 \ubaa8\uc9d1\uc694\uac15\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694.</p>"},{"location":"faq/#_4","title":"\ub0b4\uc2e0\uc740 \uc5b4\ub5bb\uac8c \ubc14\ub00c\ub098\uc694?","text":"<p>\uc11d\ucc28\ub4f1\uae09\uc774 9\ub4f1\uae09\uc5d0\uc11c 5\ub4f1\uae09\uc73c\ub85c \ubc14\ub00c\uace0, \uc131\ucde8\ud3c9\uac00(A~E)\uac00 \ud568\uaed8 \uae30\uc7ac\ub429\ub2c8\ub2e4. \uc735\ud569\uc120\ud0dd\uacfc\ubaa9 \uc911 \uc0ac\ud68c\u00b7\uacfc\ud559 \uad50\uacfc 9\uacfc\ubaa9\uc740 \uc131\ucde8\ub3c4\ub9cc \uae30\uc7ac\ub429\ub2c8\ub2e4.</p>"},{"location":"faq/#_5","title":"\uc218\uc2dc\uc640 \uc815\uc2dc \ubaa8\uc9d1\uc778\uc6d0\uc740 \uc5b4\ub5bb\uac8c \ubcc0\ud588\ub098\uc694?","text":"<p>\ub300\uad50\ud611 \uc2dc\ud589\uacc4\ud68d(2026.4.29 \uae30\uc900)\uc5d0\uc11c \uc804\uccb4 \ubaa8\uc9d1\uc778\uc6d0\uacfc \uc218\uc2dc \ubaa8\uc9d1\uc778\uc6d0\uc740 \ub298\uace0 \uc815\uc2dc \ubaa8\uc9d1\uc778\uc6d0\uc740 \uc904\uc5c8\uc2b5\ub2c8\ub2e4. \uc790\uc138\ud55c \uc218\uce58\ub294 \uc218\uc2dc, \uc815\uc2dc \ud398\uc774\uc9c0\uc5d0 \uc815\ub9ac\ud588\uc2b5\ub2c8\ub2e4.</p>"},{"location":"faq/#_6","title":"\uc774 \uc0ac\uc774\ud2b8\uc758 \uc815\ubcf4\ub294 \uacf5\uc2dd \uc790\ub8cc\uc778\uac00\uc694?","text":"<p>\uc544\ub2c8\uc694. \uacf5\uc2dd \uc790\ub8cc\ub97c \uc694\uc57d\ud55c \ucc38\uace0\uc6a9\uc785\ub2c8\ub2e4. \uc9c0\uc6d0 \uc804\uc5d0\ub294 \uacf5\uc2dd \uc790\ub8cc \ub9c1\ud06c\uc5d0\uc11c \ucd5c\uc885 \ud655\uc778\ud558\uc138\uc694.</p>"},{"location":"faq/#_7","title":"\uc624\ub958\ub97c \ubc1c\uacac\ud588\uc5b4\uc694. \uc5b4\ub514\uc5d0 \uc54c\ub9ac\ub098\uc694?","text":"<p>GitHub \uc800\uc7a5\uc18c\uc758 Issues\uc5d0 \ub0a8\uaca8 \uc8fc\uc138\uc694.</p> <p>\ud655\uc778\uc77c: 2026-11-13</p>"},{"location":"jeongsi/","title":"\uc815\uc2dc","text":""},{"location":"jeongsi/#2028","title":"2028\ud559\ub144\ub3c4 \uc815\uc2dc \ubaa8\uc9d1 \uaddc\ubaa8","text":"<p>\ub300\uad50\ud611\uc774 2026\ub144 4\uc6d4 29\uc77c \uae30\uc900\uc73c\ub85c \uacf5\ud45c\ud55c \uc2dc\ud589\uacc4\ud68d \uc911 \uc8fc\uc694 \uc804\ud615\uc720\ud615\uc785\ub2c8\ub2e4.</p> \uc804\ud615 \uc720\ud615 \ubaa8\uc9d1\uc778\uc6d0 \ube44\uc728 \uc804\ub144 \ub300\ube44 \uc218\ub2a5\uc704\uc8fc 61,779\uba85 92.4% 1,416\uba85 \uac10\uc18c \uc2e4\uae30/\uc2e4\uc801\uc704\uc8fc 4,484\uba85 6.7% 90\uba85 \uac10\uc18c \ud559\uc0dd\ubd80\uc704\uc8fc(\uad50\uacfc) 510\uba85 0.8% 282\uba85 \uc99d\uac00 <ul> <li>\uc815\uc2dc\ubaa8\uc9d1\uc740 \uc218\ub2a5\uc704\uc8fc \uc120\ubc1c \uae30\uc870\uac00 \uc720\uc9c0\ub418\uc5c8\uc2b5\ub2c8\ub2e4.</li> <li>\uc804\uccb4\uc801\uc73c\ub85c \uc815\uc2dc \ubaa8\uc9d1\uc778\uc6d0\uc740 \uc804\ub144\ubcf4\ub2e4 \uc904\uc5c8\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"jeongsi/#_2","title":"\uad70\ubcc4 \ubaa8\uc9d1 \uc77c\uc815","text":"\uad70 \uc804\ud615\uae30\uac04 \uac00\uad70 2028.1.10(\uc6d4)~17(\uc6d4) \ub098\uad70 2028.1.18(\ud654)~25(\ud654) \ub2e4\uad70 2028.1.31(\uc6d4)~2.7(\uc6d4) <p>\uc815\uc2dc \uc6d0\uc11c\uc811\uc218\ub294 2028.1.3(\uc6d4)~6(\ubaa9) \uc911 \ub300\ud559\ubcc4 3\uc77c \uc774\uc0c1\uc785\ub2c8\ub2e4. \uc790\uc138\ud55c \uc77c\uc815\uc740 \uc804\ud615 \uc77c\uc815\uc744 \ubcf4\uc138\uc694.</p>"},{"location":"jeongsi/#_3","title":"\ud1b5\ud569\ud615 \uc218\ub2a5 \uc131\uc801, \uc774\ub807\uac8c \uc81c\uacf5\ub429\ub2c8\ub2e4","text":"\uc601\uc5ed \ud3c9\uac00 \ubc29\uc2dd \uc131\uc801\ud45c \ud45c\uae30 \uad6d\uc5b4, \uc218\ud559, \ud0d0\uad6c \uc0c1\ub300\ud3c9\uac00 \ud45c\uc900\uc810\uc218, \ubc31\ubd84\uc704, \ub4f1\uae09(9\ub4f1\uae09) \uc601\uc5b4, \ud55c\uad6d\uc0ac, \uc81c2\uc678\uad6d\uc5b4/\ud55c\ubb38 \uc808\ub300\ud3c9\uac00 \ub4f1\uae09(9\ub4f1\uae09)\ub9cc <p>\uc218\ub2a5 \uc601\uc5ed \uad6c\uc131\uc740 \uc218\ub2a5 \uad6c\uc131 \uc548\ub0b4\ub97c \ucc38\uace0\ud558\uc138\uc694.</p>"},{"location":"jeongsi/#_4","title":"\uc218\ub2a5 \uad6c\uc131","text":"\uc601\uc5ed \ubb38\ud56d \uc218 \uc2dc\ud5d8 \uc2dc\uac04 \ube44\uace0 \uad6d\uc5b4 45\ubb38\ud56d 80\ubd84 \uc120\ud0dd\uacfc\ubaa9 \ud3d0\uc9c0 \uc218\ud559 30\ubb38\ud56d(\ub2e8\ub2f5\ud615 9\ubb38\ud56d \ud3ec\ud568) 100\ubd84 \uc120\ud0dd\uacfc\ubaa9 \ud3d0\uc9c0 \uc601\uc5b4 45\ubb38\ud56d(\ub4e3\uae30 17\ubb38\ud56d \ud3ec\ud568) 70\ubd84 \uc808\ub300\ud3c9\uac00 \ud55c\uad6d\uc0ac 20\ubb38\ud56d 30\ubd84 \ud544\uc218 \uc751\uc2dc, \uc808\ub300\ud3c9\uac00 \ud0d0\uad6c(\ud1b5\ud569\uc0ac\ud68c, \ud1b5\ud569\uacfc\ud559) \uacfc\ubaa9\ub2f9 25\ubb38\ud56d \uacfc\ubaa9\ub2f9 40\ubd84 \ub450 \uacfc\ubaa9 \ubaa8\ub450 \uc751\uc2dc, \ubb38\ud56d \ubc30\uc810 1.5\u00b72\u00b72.5\uc810 \uc9c1\uc5c5\ud0d0\uad6c 25\ubb38\ud56d 40\ubd84 '\uc131\uacf5\uc801\uc778 \uc9c1\uc5c5\uc0dd\ud65c'\ub9cc \ucd9c\uc81c \uc81c2\uc678\uad6d\uc5b4/\ud55c\ubb38 20\ubb38\ud56d 30\ubd84 9\uacfc\ubaa9 \uc911 1\uacfc\ubaa9 \uc120\ud0dd, \uc808\ub300\ud3c9\uac00 <p>\uc2dc\ud5d8 \uc21c\uc11c\ub294 1\uad50\uc2dc \uad6d\uc5b4, 2\uad50\uc2dc \uc218\ud559, 3\uad50\uc2dc \uc601\uc5b4, 4\uad50\uc2dc \ud55c\uad6d\uc0ac\u00b7\ud0d0\uad6c, 5\uad50\uc2dc \uc81c2\uc678\uad6d\uc5b4/\ud55c\ubb38\uc785\ub2c8\ub2e4.</p>"},{"location":"jeongsi/#_5","title":"\uc54c\uc544\ub458 \uc810","text":"<ul> <li>\ud1b5\ud569\uc0ac\ud68c\u00b7\ud1b5\ud569\uacfc\ud559 \ubc18\uc601 \ubc29\uc2dd(\ube44\uc728, \uac00\uc0b0\uc810, \ud544\uc218 \uc751\uc2dc \uc5ec\ubd80 \ub4f1)\uc740 \ub300\ud559\ubcc4\ub85c \ub2e4\ub974\ubbc0\ub85c \ubaa8\uc9d1\uc694\uac15\uc744 \ud655\uc778\ud558\uc138\uc694.</li> <li>\uc218\ub2a5 \uc2dc\ud589 \uae30\ubcf8\uacc4\ud68d\uc740 \ud55c\uad6d\uad50\uc721\uacfc\uc815\ud3c9\uac00\uc6d0\uc774 2027\ub144 3\uc6d4\uc5d0 \uacf5\uace0\ud569\ub2c8\ub2e4. \uc138\ubd80 \uc0ac\ud56d\uc774 \ubcf4\uc644\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</li> </ul> <p>\ucd9c\ucc98: \uad50\uc721\ubd80 2028\ud559\ub144\ub3c4 \uc218\ub2a5 \uc2dc\ud589\uc77c\u00b7\uc2dc\ud5d8\uc601\uc5ed \ubc1c\ud45c(2025.6), \ub300\uad50\ud611 \u300c2028\ud559\ub144\ub3c4 \ub300\ud559\uc785\ud559\uc804\ud615 \uc2dc\ud589\uacc4\ud68d \uc8fc\uc694\uc0ac\ud56d\u300d(2026.4.29), \uac01 \uc5b8\ub860 \ubcf4\ub3c4 / \ud655\uc778\uc77c: 2026-11-13</p>"},{"location":"links/","title":"\uacf5\uc2dd \uc790\ub8cc \ub9c1\ud06c","text":""},{"location":"links/#_2","title":"\uc81c\ub3c4\u00b7\uc804\ud615 \uc815\ubcf4","text":"<ul> <li>\ud55c\uad6d\ub300\ud559\uad50\uc721\ud611\uc758\ud68c(\ub300\uad50\ud611): https://www.kcue.or.kr</li> <li>\u300c2028\ud559\ub144\ub3c4 \ub300\ud559\uc785\ud559\uc804\ud615\uae30\ubcf8\uc0ac\ud56d\u300d\uacfc \uac1c\uc815\ubcf8, \uc2dc\ud589\uacc4\ud68d \uc8fc\uc694\uc0ac\ud56d</li> <li>\ub300\uc785\uc815\ubcf4\ud3ec\ud138 \uc5b4\ub514\uac00: https://www.adiga.kr</li> <li>\ub300\ud559\ubcc4 \uc804\ud615 \uc815\ubcf4, \uc2dc\ud589\uacc4\ud68d \uc790\ub8cc\uc9d1</li> <li>\uad50\uc721\ubd80: https://www.moe.go.kr</li> <li>2028 \ub300\uc785\uc81c\ub3c4 \uac1c\ud3b8\uc548, \uc218\ub2a5 \uc2dc\ud589 \ubcf4\ub3c4\uc790\ub8cc</li> </ul>"},{"location":"links/#_3","title":"\uc218\ub2a5","text":"<ul> <li>\ud55c\uad6d\uad50\uc721\uacfc\uc815\ud3c9\uac00\uc6d0: https://www.suneung.re.kr</li> <li>\uc218\ub2a5 \uc2dc\ud589 \uae30\ubcf8\uacc4\ud68d(2027\ub144 3\uc6d4 \uacf5\uace0 \uc608\uc815), \ubaa8\uc758\ud3c9\uac00</li> <li>EBSi: https://www.ebsi.co.kr</li> <li>\uc785\uc2dc \uc815\ubcf4, \uc218\ub2a5 \ub300\ube44 \uc790\ub8cc</li> </ul>"},{"location":"links/#_4","title":"\ub300\ud559\ubcc4 \uc815\ubcf4","text":"<ul> <li>\uc9c0\uc6d0 \ub300\ud559 \uc785\ud559\ucc98 \ud648\ud398\uc774\uc9c0: \ubaa8\uc9d1\uc694\uac15\uacfc \ud559\uc0dd\ubd80 \ubc18\uc601 \ubc29\ubc95, \uc218\ub2a5\ucd5c\uc800\ud559\ub825\uae30\uc900 \ud655\uc778</li> </ul> <p>\ub300\uc785 \uc815\ubcf4\ub294 \uac1c\uc815\ub420 \uc218 \uc788\uc73c\ub2c8, \uc774 \uc0ac\uc774\ud2b8\ubcf4\ub2e4 \uc704 \uacf5\uc2dd \uc790\ub8cc\ub97c \uc6b0\uc120\ud558\uc138\uc694.</p>"},{"location":"overview/","title":"2028 \ub300\uc785 \uac1c\uc694","text":"<p>2028\ud559\ub144\ub3c4\ub294 2022 \uac1c\uc815 \uad50\uc721\uacfc\uc815\uacfc 2023\ub144 12\uc6d4\uc5d0 \ud655\uc815\ub41c 2028 \ub300\uc785\uc81c\ub3c4 \uac1c\ud3b8\uc548\uc774 \ucc98\uc74c \uc801\uc6a9\ub418\ub294 \uc785\uc2dc\uc785\ub2c8\ub2e4. 2025\ub144\uc5d0 \uace01\uc774 \ub41c \ud559\uc0dd\ub4e4\uc774 \uccab \uc801\uc6a9 \ub300\uc0c1\uc785\ub2c8\ub2e4.</p>"},{"location":"overview/#_1","title":"\uc8fc\uc694 \ubcc0\ud654","text":"\uad6c\ubd84 \ubcc0\ud654 \ub0b4\uc6a9 \uc218\ub2a5 \uad6d\uc5b4\u00b7\uc218\ud559\u00b7\uc0ac\ud68c\u00b7\uacfc\ud559 \ud0d0\uad6c\uc758 \uc120\ud0dd\uacfc\ubaa9 \ud3d0\uc9c0, \ubaa8\ub4e0 \uc218\ud5d8\uc0dd\uc774 \uac19\uc740 \uc2dc\ud5d8\uc744 \uce58\ub974\ub294 \ud1b5\ud569\ud615 \uccb4\uc81c \uc218\ub2a5 \ud0d0\uad6c \uc0ac\ud68c\u00b7\uacfc\ud559\ud0d0\uad6c \uc751\uc2dc\uc790\ub294 \ud1b5\ud569\uc0ac\ud68c\uc640 \ud1b5\ud569\uacfc\ud559\uc744 \ubaa8\ub450 \uc751\uc2dc \uc218\ub2a5 \ud615\uc2dd \ub17c\u00b7\uc11c\uc220\ud615 \ubb38\ud56d\uc740 \ub3c4\uc785\ud558\uc9c0 \uc54a\uc74c, \ubbf8\uc801\ubd84\u2161\u00b7\uae30\ud558 \ub4f1 '\uc2ec\ud654\uc218\ud559' \uc601\uc5ed\uc740 \uc218\ub2a5\uc5d0 \ud3ec\ud568\ud558\uc9c0 \uc54a\uc74c \ub0b4\uc2e0 \uc11d\ucc28\ub4f1\uae09 9\ub4f1\uae09\uc81c\uc5d0\uc11c 5\ub4f1\uae09\uc81c\ub85c \ubcc0\uacbd, \uc131\ucde8\ud3c9\uac00(A~E)\uc640 \ud568\uaed8 \uae30\uc7ac 8\uc6d4 \ubaa8\uc758\ud3c9\uac00 8\uc6d4 \ub9d0 \uc2e4\uc2dc \ud6c4 \uc131\uc801\uc744 \ud655\uc778\ud558\uace0 \uc218\uc2dc \uc6d0\uc11c\uc811\uc218\uac00 \uc2dc\uc791\ub418\ub294 \uc77c\uc815"},{"location":"overview/#_2","title":"\ub0b4\uc2e0(\ud559\uc0dd\ubd80 \uad50\uacfc) \ubcc0\ud654","text":"<ul> <li>2025\ud559\ub144\ub3c4 \uace0\ub4f1\ud559\uad50 \uc785\ud559\uc0dd\ubd80\ud130 \uc11d\ucc28\ub4f1\uae09\uc774 5\ub4f1\uae09\uc81c\ub85c \ubc14\ub00c\uc5c8\uace0, 1\ub4f1\uae09 \ube44\uc728\uc774 \uc0c1\uc704 \ub204\uc801 4%\uc5d0\uc11c 10%\ub85c \ub113\uc5b4\uc84c\uc2b5\ub2c8\ub2e4.</li> <li>\uc131\uc801\ud45c\uc5d0\ub294 A~E \uc131\ucde8\ud3c9\uac00\uc640 \uc11d\ucc28\ub4f1\uae09\uc774 \ud568\uaed8 \uae30\uc7ac\ub429\ub2c8\ub2e4.</li> <li>\uc735\ud569\uc120\ud0dd\uacfc\ubaa9 \uc911 \uc0ac\ud68c\u00b7\uacfc\ud559 \uad50\uacfc 9\uacfc\ubaa9\uc740 \uc0c1\ub300\ud3c9\uac00 \uc5c6\uc774 \uc131\ucde8\ub3c4(\uc808\ub300\ud3c9\uac00)\ub9cc \uae30\uc7ac\ub429\ub2c8\ub2e4.</li> </ul>"},{"location":"overview/#2028-20258","title":"2028\ud559\ub144\ub3c4 \ub300\ud559\uc785\ud559\uc804\ud615\uae30\ubcf8\uc0ac\ud56d \uc8fc\uc694 \ubcc0\uacbd (2025.8 \ubc1c\ud45c)","text":"<p>\ub300\uad50\ud611\uc774 \ud655\uc815\ud55c \uae30\ubcf8\uc0ac\ud56d\uc758 \uc8fc\uc694 \ubcc0\uacbd\uc740 \uc544\ub798 \uc138 \uac00\uc9c0\uc785\ub2c8\ub2e4. \uc774\ud6c4 2026\ub144 7\uc6d4\uc5d0 \uac1c\uc815\ubcf8\uc774 \uacf5\uac1c\ub418\uc5c8\uc73c\ub2c8 \uc6d0\ubb38\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694.</p> <ol> <li>\ud2b9\uc131\ud654\uace0\uc878\uc5c5\uc790 \ud2b9\ubcc4\uc804\ud615: \ub3d9\uc77c\uacc4\uc5f4 \uc778\uc815 \uae30\uc900\uc744 '\uae30\uc900\ud559\uacfc'\uc5d0\uc11c \uad50\uacfc(\uad70) \uae30\uc900\uc73c\ub85c \ubc14\uafb8\uace0, \ud559\uc0dd\uc774 24\ud559\uc810 \uc774\uc0c1 \uc774\uc218\ud55c \uad50\uacfc(\uad70)\uc744 \ub3d9\uc77c\uacc4\uc5f4\ub85c \uc778\uc815\ud569\ub2c8\ub2e4.</li> <li>\ub18d\uc5b4\ucd0c\ud559\uc0dd \ud2b9\ubcc4\uc804\ud615: \uc9c0\uc6d0\uc790\uaca9 \ud655\uc778\uc11c \ub4f1\uc744 \ub300\uad50\ud611 \uacf5\ud1b5\uc591\uc2dd\uc73c\ub85c \ud1b5\uc77c\ud569\ub2c8\ub2e4.</li> <li>\ub18d\uc5b4\ucd0c\u00b7\uc9c0\uc5ed\uc778\uc7ac\u00b7\ud2b9\uc131\ud654\uace0\uc878\uc5c5\uc790 \ud2b9\ubcc4\uc804\ud615: \uc9c0\uc6d0\uc790\uaca9\uc758 \ud559\uad50 '\uc878\uc5c5\uc77c'\uc740 \ud559\uad50\uc0dd\ud65c\uae30\ub85d\ubd80\uc5d0 \uae30\uc7ac\ub41c \ub0a0\uc9dc\ub97c \uae30\uc900\uc73c\ub85c \ud569\ub2c8\ub2e4.</li> </ol>"},{"location":"overview/#2028-2026429","title":"\ubaa8\uc9d1 \ub3d9\ud5a5 (2028\ud559\ub144\ub3c4 \ub300\ud559\uc785\ud559\uc804\ud615\uc2dc\ud589\uacc4\ud68d, 2026.4.29 \uae30\uc900)","text":"<ul> <li>\uc804\uad6d 194\uac1c \ud68c\uc6d0\ub300\ud559\uc774 \uc81c\ucd9c\ud55c \uc2dc\ud589\uacc4\ud68d\uc744 \ub300\uad50\ud611\uc774 \ucde8\ud569\ud574 \uacf5\ud45c\ud588\uc2b5\ub2c8\ub2e4.</li> <li>\uc804\uccb4 \ubaa8\uc9d1\uc778\uc6d0\uacfc \uc218\uc2dc \ubaa8\uc9d1\uc778\uc6d0\uc740 \ub298\uace0 \uc815\uc2dc \ubaa8\uc9d1\uc778\uc6d0\uc740 \uc904\uc5c8\uc2b5\ub2c8\ub2e4.</li> <li>\uc218\uc2dc\ub294 \ud559\uc0dd\ubd80\uc704\uc8fc, \uc815\uc2dc\ub294 \uc218\ub2a5\uc704\uc8fc\ub85c \uc120\ubc1c\ud558\ub294 \uae30\uc870\uac00 \uc720\uc9c0\ub418\uc5c8\uc2b5\ub2c8\ub2e4.</li> <li>\uc790\uc138\ud55c \uc218\uce58\ub294 \uc218\uc2dc, \uc815\uc2dc \ud398\uc774\uc9c0\ub97c \ucc38\uace0\ud558\uc138\uc694.</li> </ul>"},{"location":"overview/#_3","title":"\uc774 \uc0ac\uc774\ud2b8\ub97c \uc77d\ub294 \ubc95","text":"<p>\ub300\uc785 \uc815\ubcf4\ub294 \uac1c\uc815\ub418\ub294 \uacbd\uc6b0\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \ud398\uc774\uc9c0 \ud558\ub2e8\uc758 \ucd9c\ucc98\uc640 \ud655\uc778\uc77c\uc744 \ud568\uaed8 \ubcf4\uace0, \uc9c0\uc6d0 \uc804\uc5d0\ub294 \uacf5\uc2dd \uc790\ub8cc\ub85c \ub2e4\uc2dc \ud655\uc778\ud574 \uc8fc\uc138\uc694.</p> <p>\ucd9c\ucc98: \uad50\uc721\ubd80 2028 \ub300\uc785\uc81c\ub3c4 \uac1c\ud3b8 \ud655\uc815\uc548(2023.12), \ub300\uad50\ud611 \u300c2028\ud559\ub144\ub3c4 \ub300\ud559\uc785\ud559\uc804\ud615\uae30\ubcf8\uc0ac\ud56d\u300d(2025.8) \ubc0f \uc2dc\ud589\uacc4\ud68d \uc8fc\uc694\uc0ac\ud56d(2026.4), \uac01 \uc5b8\ub860 \ubcf4\ub3c4 / \ud655\uc778\uc77c: 2026-11-13</p>"},{"location":"prepare/","title":"\ud559\ub144\ubcc4 \uc900\ube44","text":"<p>2028\ud559\ub144\ub3c4 \uc785\uc2dc\uc0dd\uc740 2025\ub144\uc5d0 \uace01\uc774 \ub41c \ud559\uc0dd\ub4e4\uc785\ub2c8\ub2e4. 2026\ub144 11\uc6d4 \ud604\uc7ac \uace02\uc774\uba70, 2027\ub144\uc5d0 \uace03\uc774 \ub429\ub2c8\ub2e4. \uc544\ub798\ub294 \uacf5\uc2dd \uc77c\uc815\uacfc \uc81c\ub3c4 \ubcc0\ud654\ub97c \ubc14\ud0d5\uc73c\ub85c \uc815\ub9ac\ud55c \uc77c\ubc18\uc801\uc778 \uc810\uac80 \ud56d\ubaa9\uc785\ub2c8\ub2e4.</p>"},{"location":"prepare/#2-2026","title":"\ud604\uc7ac \uace02 (2026\ub144)","text":"<ul> <li>\ub0b4\uc2e0 5\ub4f1\uae09\uc81c\uc640 \uc131\ucde8\ud3c9\uac00 \ubcd1\uae30 \ubc29\uc2dd\uc744 \uc774\ud574\ud558\uace0, \ud559\uad50 \uc131\uc801\ud45c\uc758 \ud45c\uae30\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.</li> <li>\ud1b5\ud569\uc0ac\ud68c\u00b7\ud1b5\ud569\uacfc\ud559, \uad6d\uc5b4\u00b7\uc218\ud559 \uacf5\ud1b5 \ubc94\uc704\ub97c \uc810\uac80\ud569\ub2c8\ub2e4. \uc120\ud0dd\uacfc\ubaa9\uc774 \uc5c6\uc73c\ubbc0\ub85c \uac19\uc740 \ubc94\uc704\ub97c \ubaa8\ub450\uac00 \uacf5\ubd80\ud569\ub2c8\ub2e4.</li> <li>\uc9c4\ub85c\uc5d0 \ub9de\ub294 \uacfc\ubaa9 \uc774\uc218 \ud604\ud669\uc744 \uc815\ub9ac\ud558\uace0, \uc9c0\uc6d0 \ud76c\ub9dd \ub300\ud559\uc758 \uc694\uad6c \uc0ac\ud56d\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.</li> <li>\ud76c\ub9dd \ub300\ud559 \uc785\ud559\ucc98\uc758 2028\ud559\ub144\ub3c4 \uc2dc\ud589\uacc4\ud68d\uacfc \ubaa8\uc9d1\uc694\uac15 \uc608\uace0 \uc790\ub8cc\ub97c \uc0b4\ud3b4\ubd05\ub2c8\ub2e4.</li> </ul>"},{"location":"prepare/#3-2027","title":"\uace03 (2027\ub144)","text":"\uc2dc\uae30 \uc810\uac80 \ud56d\ubaa9 3\uc6d4 \ud55c\uad6d\uad50\uc721\uacfc\uc815\ud3c9\uac00\uc6d0\uc774 \uacf5\uace0\ud558\ub294 \uc218\ub2a5 \uc2dc\ud589 \uae30\ubcf8\uacc4\ud68d \ud655\uc778 6\uc6d4 6\uc6d4 \ubaa8\uc758\ud3c9\uac00\ub85c \ud559\uc2b5 \uc0c1\ud669 \uc810\uac80 8\uc6d4 \ub9d0 8\uc6d4 \ubaa8\uc758\ud3c9\uac00 \uc131\uc801\uc744 \ud655\uc778\ud558\uace0 \uc218\uc2dc \uc9c0\uc6d0 \uc804\ub7b5 \uc815\ub9ac 9\uc6d4 20~23\uc77c \uc218\uc2dc \uc6d0\uc11c\uc811\uc218 (\ub300\ud559\ubcc4 3\uc77c \uc774\uc0c1) 11\uc6d4 18\uc77c \uc218\ub2a5 \uc751\uc2dc 12\uc6d4 10\uc77c \uc218\ub2a5 \uc131\uc801 \ud1b5\uc9c0, \uc815\uc2dc \uc9c0\uc6d0 \uc804\ub7b5 \uc218\ub9bd 12\uc6d4 21\uc77c\uae4c\uc9c0 \uc218\uc2dc \ud569\uaca9\uc790 \ubc1c\ud45c 2028\ub144 1\uc6d4 3~6\uc77c \uc815\uc2dc \uc6d0\uc11c\uc811\uc218"},{"location":"prepare/#_2","title":"\ud559\ubd80\ubaa8\u00b7\uad50\uc0ac\ub97c \uc704\ud55c \uc810\uac80","text":"<ul> <li>\uc790\ub140\u00b7\ud559\uc0dd\uc774 \uc9c0\uc6d0\ud560 \ub300\ud559\uc758 \ubaa8\uc9d1\uc694\uac15\uc744 \ud568\uaed8 \ud655\uc778\ud569\ub2c8\ub2e4.</li> <li>\uc77c\uc815\uc740 \uc804\ud615 \uc77c\uc815 \ud45c\ub97c \uae30\uc900\uc73c\ub85c \ud558\uace0, \ub300\ud559\ubcc4 \uacf5\uace0\ub85c \ub2e4\uc2dc \ud655\uc778\ud569\ub2c8\ub2e4.</li> <li>\uc81c\ub3c4 \ubcc0\ud654\ub098 \uac1c\uc815\uc740 \uacf5\uc2dd \uc790\ub8cc \ub9c1\ud06c\uc5d0\uc11c \ud655\uc778\ud569\ub2c8\ub2e4.</li> </ul> <p>\ucd9c\ucc98: \uad50\uc721\ubd80 2028 \ub300\uc785\uc81c\ub3c4 \uac1c\ud3b8 \ud655\uc815\uc548, \ub300\uad50\ud611 \uc2dc\ud589\uacc4\ud68d \uc8fc\uc694\uc0ac\ud56d, \uad50\uc721\ubd80 \uc218\ub2a5 \uc2dc\ud589\uc77c \ubc1c\ud45c / \ud655\uc778\uc77c: 2026-11-13</p>"},{"location":"schedule/","title":"\uc804\ud615 \uc77c\uc815","text":"<p>\uc544\ub798\ub294 \ub300\uad50\ud611 \u300c2028\ud559\ub144\ub3c4 \ub300\ud559\uc785\ud559\uc804\ud615 \uc2dc\ud589\uacc4\ud68d \uc8fc\uc694\uc0ac\ud56d\u300d(2026.4.29)\uacfc \uad50\uc721\ubd80 \uc218\ub2a5 \uc2dc\ud589 \ubc1c\ud45c\ub97c \uc815\ub9ac\ud55c \uac83\uc785\ub2c8\ub2e4. \ub300\ud559\ubcc4 \uc138\ubd80 \uc77c\uc815\uc740 \ubaa8\uc9d1\uc694\uac15\uc744 \ud655\uc778\ud558\uc138\uc694.</p>"},{"location":"schedule/#_2","title":"\ud55c\ub208\uc5d0 \ubcf4\ub294 \ud750\ub984","text":"\uc2dc\uae30 \ub0b4\uc6a9 2027\ub144 6\uc6d4 6\uc6d4 \ubaa8\uc758\ud3c9\uac00 (\ud55c\uad6d\uad50\uc721\uacfc\uc815\ud3c9\uac00\uc6d0 \uacf5\uace0 \ud655\uc778) 2027\ub144 8\uc6d4 \ub9d0 8\uc6d4 \ubaa8\uc758\ud3c9\uac00, \uc131\uc801 \ud655\uc778 \ud6c4 \uc218\uc2dc \uc6d0\uc11c\uc811\uc218 2027\ub144 9\uc6d4 20\uc77c(\uc6d4)~23\uc77c(\ubaa9) \uc218\uc2dc\ubaa8\uc9d1 \uc6d0\uc11c\uc811\uc218 (\ub300\ud559\ubcc4 3\uc77c \uc774\uc0c1) 2027\ub144 11\uc6d4 18\uc77c(\ubaa9) \ub300\ud559\uc218\ud559\ub2a5\ub825\uc2dc\ud5d8 2027\ub144 12\uc6d4 10\uc77c(\uae08) \uc218\ub2a5 \uc131\uc801 \ud1b5\uc9c0 2028\ub144 1\uc6d4 3\uc77c(\uc6d4)~6\uc77c(\ubaa9) \uc815\uc2dc\ubaa8\uc9d1 \uc6d0\uc11c\uc811\uc218 (\ub300\ud559\ubcc4 3\uc77c \uc774\uc0c1)"},{"location":"schedule/#_3","title":"\uc218\uc2dc\ubaa8\uc9d1","text":"\uad6c\ubd84 \uc77c\uc815 \uc6d0\uc11c\uc811\uc218 2027.9.20(\uc6d4)~23(\ubaa9) \uc911 3\uc77c \uc774\uc0c1 \uc804\ud615\uae30\uac04 2027.9.24(\uae08)~12.20(\uc6d4) (88\uc77c) \ud569\uaca9\uc790 \ubc1c\ud45c 2027.12.21(\ud654)\uae4c\uc9c0 \ud569\uaca9\uc790 \ub4f1\ub85d 2027.12.22(\uc218)~24(\uae08) (3\uc77c) \ubbf8\ub4f1\ub85d \ucda9\uc6d0 \ub4f1\ub85d \ub9c8\uac10 2027.12.31(\uae08) 18\uc2dc\uae4c\uc9c0 <p>\uc7ac\uc678\uad6d\ubbfc \ud2b9\ubcc4\uc804\ud615\uc740 \uc6d0\uc11c\uc811\uc218\ub97c 7\uc6d4\uc5d0 \uc2e4\uc2dc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4(2027.7.5~9). \ud574\ub2f9\ub418\ub294 \uacbd\uc6b0 \ub300\ud559\ubcc4 \uacf5\uace0\ub97c \ud655\uc778\ud558\uc138\uc694.</p>"},{"location":"schedule/#_4","title":"\uc815\uc2dc\ubaa8\uc9d1","text":"\uad6c\ubd84 \uc77c\uc815 \uc6d0\uc11c\uc811\uc218 2028.1.3(\uc6d4)~6(\ubaa9) \uc911 3\uc77c \uc774\uc0c1 \uc804\ud615\uae30\uac04 \uac00\uad70 2028.1.10(\uc6d4)~17(\uc6d4) (8\uc77c) \uc804\ud615\uae30\uac04 \ub098\uad70 2028.1.18(\ud654)~25(\ud654) (8\uc77c) \uc804\ud615\uae30\uac04 \ub2e4\uad70 2028.1.31(\uc6d4)~2.7(\uc6d4) (8\uc77c) \ud569\uaca9\uc790 \ubc1c\ud45c 2028.2.10(\ubaa9)\uae4c\uc9c0 \ud569\uaca9\uc790 \ub4f1\ub85d 2028.2.11(\uae08)~14(\uc6d4) (4\uc77c) \ubbf8\ub4f1\ub85d \ucda9\uc6d0 \ub4f1\ub85d \ub9c8\uac10 2028.2.21(\uc6d4) 18\uc2dc\uae4c\uc9c0"},{"location":"schedule/#_5","title":"\ucd94\uac00\ubaa8\uc9d1","text":"<ul> <li>\ubaa8\uc9d1\uc778\uc6d0 \uacf5\uc9c0\ub294 2028.2.21(\uc6d4) 18\uc2dc \uc774\ud6c4\ubd80\ud130 \uac00\ub2a5\ud569\ub2c8\ub2e4.</li> <li>\uc6d0\uc11c\uc811\uc218\uc640 \uc804\ud615\uc740 2028.2.22(\ud654) 9\uc2dc\ubd80\ud130 \uc2e4\uc2dc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"schedule/#_6","title":"\ud655\uc778\ud560 \uc810","text":"<ul> <li>\uc218\ub2a5 \ub0a0\uc9dc\uc640 \uc131\uc801 \ud1b5\uc9c0\uc77c\uc740 \uad50\uc721\ubd80 \ubc1c\ud45c \uae30\uc900\uc785\ub2c8\ub2e4. \ud55c\uad6d\uad50\uc721\uacfc\uc815\ud3c9\uac00\uc6d0\uc774 2027\ub144 3\uc6d4\uc5d0 \uacf5\uace0\ud558\ub294 \uc218\ub2a5 \uc2dc\ud589 \uae30\ubcf8\uacc4\ud68d\uc5d0\uc11c \uc138\ubd80 \uc0ac\ud56d\uc744 \ub2e4\uc2dc \ud655\uc778\ud558\uc138\uc694.</li> <li>6\uc6d4\u00b78\uc6d4 \ubaa8\uc758\ud3c9\uac00\uc758 \uc815\ud655\ud55c \ub0a0\uc9dc\ub294 \ud3c9\uac00\uc6d0 \uacf5\uace0\ub85c \ud655\uc778\ud558\uc138\uc694.</li> </ul> <p>\ucd9c\ucc98: \ub300\uad50\ud611 \u300c2028\ud559\ub144\ub3c4 \ub300\ud559\uc785\ud559\uc804\ud615 \uc2dc\ud589\uacc4\ud68d \uc8fc\uc694\uc0ac\ud56d\u300d(2026.4.29), \uad50\uc721\ubd80 \ubcf4\ub3c4\uc790\ub8cc \u300c2028\ud559\ub144\ub3c4 \ub300\ud559\uc218\ud559\ub2a5\ub825\uc2dc\ud5d8\uc740 2027\ub144 11\uc6d4 18\uc77c(\ubaa9)\uc5d0 \uc2dc\ud589\ub429\ub2c8\ub2e4\u300d, EBSi \ub300\ud559\uc785\ud559\uc804\ud615 \uc2dc\ud589\uacc4\ud68d \uc548\ub0b4 / \ud655\uc778\uc77c: 2026-11-13</p>"},{"location":"susi/","title":"\uc218\uc2dc","text":""},{"location":"susi/#2028","title":"2028\ud559\ub144\ub3c4 \uc218\uc2dc \ubaa8\uc9d1 \uaddc\ubaa8","text":"<p>\ub300\uad50\ud611\uc774 2026\ub144 4\uc6d4 29\uc77c \uae30\uc900\uc73c\ub85c \uacf5\ud45c\ud55c \uc2dc\ud589\uacc4\ud68d\uc785\ub2c8\ub2e4.</p> \uc804\ud615 \uc720\ud615 \ubaa8\uc9d1\uc778\uc6d0 \ube44\uc728 \uc804\ub144 \ub300\ube44 \ud559\uc0dd\ubd80\uc704\uc8fc(\uad50\uacfc) 157,991\uba85 56.0% 1,588\uba85 \uc99d\uac00 \ud559\uc0dd\ubd80\uc704\uc8fc(\uc885\ud569) 84,704\uba85 30.0% 2,773\uba85 \uc99d\uac00 \ub17c\uc220\uc704\uc8fc 12,727\uba85 4.5% 16\uba85 \uc99d\uac00 \uc2e4\uae30/\uc2e4\uc801\uc704\uc8fc 21,848\uba85 7.8% 106\uba85 \uac10\uc18c \uae30\ud0c0 4,625\uba85 1.6% 41\uba85 \uc99d\uac00 \uc218\uc2dc \ud569\uacc4 281,895\uba85 100% 4,312\uba85 \uc99d\uac00 <ul> <li>\uc218\uc2dc\ubaa8\uc9d1\uc740 \ud559\uc0dd\ubd80\uc704\uc8fc \uc120\ubc1c\uc774 \uc911\uc2ec\uc774\uba70, \uad50\uacfc\uc640 \uc885\ud569\uc744 \ud569\uce58\uba74 86%\uc785\ub2c8\ub2e4.</li> <li>2027\ud559\ub144\ub3c4 \uc218\uc2dc \ud569\uacc4\ub294 277,583\uba85\uc774\uc5c8\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"susi/#_2","title":"\uc804\ud615 \uc720\ud615 \uac04\ub2e8 \uc124\uba85","text":"<ul> <li>\ud559\uc0dd\ubd80\uad50\uacfc: \uad50\uacfc \uc131\uc801\uc744 \uc911\uc2ec\uc73c\ub85c \uc120\ubc1c\ud569\ub2c8\ub2e4.</li> <li>\ud559\uc0dd\ubd80\uc885\ud569: \uad50\uacfc \uc678\uc5d0 \ud65c\ub3d9 \uae30\ub85d\uacfc \uc11c\ub958\u00b7\uba74\uc811 \ub4f1\uc744 \uc885\ud569\ud574 \ud3c9\uac00\ud569\ub2c8\ub2e4.</li> <li>\ub17c\uc220: \ub300\ud559\ubcc4 \ub17c\uc220\uace0\uc0ac\ub97c \ubc18\uc601\ud569\ub2c8\ub2e4.</li> <li>\uc2e4\uae30/\uc2e4\uc801: \uc608\uccb4\ub2a5 \uc2e4\uae30 \ub4f1 \uc2e4\uae30\u00b7\uc2e4\uc801\uc744 \uc911\uc2ec\uc73c\ub85c \ud3c9\uac00\ud569\ub2c8\ub2e4.</li> </ul>"},{"location":"susi/#_3","title":"\uc54c\uc544\ub458 \uc810","text":"<ul> <li>\ub0b4\uc2e0 \uc11d\ucc28\ub4f1\uae09\uc774 5\ub4f1\uae09\uc81c\ub85c \ubc14\ub00c\uace0 \uc131\ucde8\ud3c9\uac00\uac00 \ubcd1\uae30\ub418\ubbc0\ub85c, \ub300\ud559\ubcc4\ub85c \ud559\uc0dd\ubd80 \ubc18\uc601 \ubc29\uc2dd\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\uc6d0 \ub300\ud559\uc758 \ud559\uc0dd\ubd80 \ubc18\uc601 \ubc29\ubc95\uc744 \ubaa8\uc9d1\uc694\uac15\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694.</li> <li>\uc218\ub2a5\ucd5c\uc800\ud559\ub825\uae30\uc900\uc740 \ub300\ud559\u00b7\ubaa8\uc9d1\ub2e8\uc704\ub9c8\ub2e4 \ub2e4\ub985\ub2c8\ub2e4. \ud1b5\ud569\uc0ac\ud68c\u00b7\ud1b5\ud569\uacfc\ud559\uc774 \ud0d0\uad6c\ub85c \ubc18\uc601\ub418\ub294 \ubc29\uc2dd\ub3c4 \ub300\ud559\ubcc4\ub85c \ud655\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.</li> <li>\uc218\uc2dc \uc9c0\uc6d0 \ud69f\uc218 \uc81c\ud55c \ub4f1 \uc9c0\uc6d0 \uaddc\uc815\uc740 \u300c2028\ud559\ub144\ub3c4 \ub300\ud559\uc785\ud559\uc804\ud615\uae30\ubcf8\uc0ac\ud56d\u300d \uc6d0\ubb38\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694.</li> <li>\ud2b9\uc131\ud654\uace0\uc878\uc5c5\uc790, \ub18d\uc5b4\ucd0c\ud559\uc0dd \ub4f1 \ud2b9\ubcc4\uc804\ud615\uc740 \uae30\ubcf8\uc0ac\ud56d \ubcc0\uacbd(\uacf5\ud1b5\uc591\uc2dd, \uc878\uc5c5\uc77c \uae30\uc900, \ub3d9\uc77c\uacc4\uc5f4 \uc778\uc815)\uc744 \ud655\uc778\ud558\uc138\uc694. \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uac1c\uc694\ub97c \ucc38\uace0\ud558\uc138\uc694.</li> </ul> <p>\ucd9c\ucc98: \ub300\uad50\ud611 \u300c2028\ud559\ub144\ub3c4 \ub300\ud559\uc785\ud559\uc804\ud615 \uc2dc\ud589\uacc4\ud68d \uc8fc\uc694\uc0ac\ud56d\u300d(2026.4.29), EBSi \ub300\ud559\uc785\ud559\uc804\ud615 \uc2dc\ud589\uacc4\ud68d \uc548\ub0b4 / \ud655\uc778\uc77c: 2026-11-13</p>"}]}